#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
value="${2:-}"
config="$HOME/.config/omarchy/snapman.conf"
config_dir="${config%/*}"

case "$mode" in
count | age) ;;
*)
  printf 'Snapman: invalid retention mode.\n' >&2
  exit 2
  ;;
esac

if [[ ! "$value" =~ ^[1-9][0-9]*$ ]]; then
  printf 'Snapman: invalid retention value.\n' >&2
  exit 2
fi

if [[ -L "$config" ]]; then
  printf 'Snapman: refusing to overwrite symlinked retention config.\n' >&2
  exit 1
fi

tmp=$(mktemp "$config_dir/.snapman.conf.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT
printf 'RETENTION_MODE=%s\nRETENTION_VALUE=%s\n' "$mode" "$value" > "$tmp"
chmod 600 "$tmp"

# rename(2), used by mv -T, replaces a symlink rather than following it.
mv -fT -- "$tmp" "$config"
trap - EXIT
