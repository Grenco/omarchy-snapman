#!/usr/bin/env bash
set -u

conf="${SNAPMAN_CONF:-$HOME/.config/omarchy/snapman.conf}"
[[ -f "$conf" ]] || exit 0

mode=$(sed -n 's/^RETENTION_MODE=//p' "$conf" | tr -d '[:space:]')
value=$(sed -n 's/^RETENTION_VALUE=//p' "$conf" | tr -d '[:space:]')
[[ -n "$mode" && -n "$value" ]] || exit 0

case "$mode" in
count)
  [[ "$value" =~ ^[1-9][0-9]*$ && "$value" -le 20 ]] || exit 0
  # The authoritative count policy lives in /etc/snapper/configs/root and is
  # enforced with root by `omarchy update`. This is only a safety net for
  # count-based retention in case the config was never written.
  snapper -c root cleanup number >/dev/null 2>&1 || true
  ;;
age)
  [[ "$value" =~ ^[1-9][0-9]*$ && "$value" -le 365 ]] || exit 0
  cutoff=$(date -d "now - ${value} days" +%s 2>/dev/null) || exit 0
  to_delete=()
  while IFS=$'\t' read -r num date; do
    [[ -n "$num" ]] || continue
    ts=$(date -d "$date" +%s 2>/dev/null) || continue
    (( ts < cutoff )) && to_delete+=("$num")
  done < <(
    snapper -c root --jsonout --no-headers list --disable-used-space 2>/dev/null |
      jq -r '.root[] | select(.number != 0 and .date != "" and (.userdata.important // "") != "yes") | "\(.number)\t\(.date)"'
  )
  if (( ${#to_delete[@]} > 0 )); then
    snapper -c root delete "${to_delete[@]}" >/dev/null 2>&1 || true
  fi
  ;;
esac
